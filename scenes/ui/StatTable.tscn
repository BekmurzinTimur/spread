[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/StatTable.gd" id="1_stats"]

[node name="StatTable" type="PanelContainer"]
custom_minimum_size = Vector2(470, 0)
mouse_filter = 2
script = ExtResource("1_stats")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 20
text = "STATS AS A RUN STARTS"

[node name="Grid" type="GridContainer" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 4
columns = 4
